{# Show features and actions with limited uses, charges, or per-turn/per-attack abilities #}
{# Collect features from various sources in the character data #}
{% set all_features = [] %}
{% set feature_ids = [] %}

{# Helper macro to check if feature should be included #}
{% macro shouldIncludeFeature(feature) %}
  {% set feature_name = feature.definition.name ?? feature.name ?? '' %}
  {% set description = (feature.definition.description ?? feature.snippet ?? feature.description ?? '')|lower %}

  {# Exclude purely informational/GM discretionary features #}
  {% set is_informational =
     ('at your gm' in description and 'discretion' in description) or
     (description|length < 100 and 'gm' in description) %}

  {# Only include if it has a name, matches our criteria, and isn't purely informational #}
  {% if feature_name is not empty and not is_informational and (
     (feature.limitedUse is defined and feature.limitedUse)
     or ('per turn' in description)
     or ('on your turn' in description)
     or ('per attack' in description)
     or ('once per turn' in description)
     or ('once on your turn' in description)
  ) %}
    true
  {% endif %}
{% endmacro %}

{# Check for features #}
{% if character.features is defined %}
  {% for feature in character.features %}
    {% if _self.shouldIncludeFeature(feature) %}
      {% set feature_id = feature.id ?? feature.definition.id ?? loop.index0 %}
      {% if feature_id not in feature_ids %}
        {% set all_features = all_features|merge([feature]) %}
        {% set feature_ids = feature_ids|merge([feature_id]) %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

{# Check for class features #}
{% if character.classFeatures is defined %}
  {% for feature in character.classFeatures %}
    {% if _self.shouldIncludeFeature(feature) %}
      {% set feature_id = feature.id ?? feature.definition.id ?? ('cf_' ~ loop.index0) %}
      {% if feature_id not in feature_ids %}
        {% set all_features = all_features|merge([feature]) %}
        {% set feature_ids = feature_ids|merge([feature_id]) %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

{# Check for actions #}
{% if character.actions is defined %}
  {% for action_category in character.actions %}
    {% if action_category is iterable %}
      {% for action in action_category %}
        {% if _self.shouldIncludeFeature(action) %}
          {% set feature_id = action.id ?? action.definition.id ?? ('act_' ~ loop.parent.loop.index0 ~ '_' ~ loop.index0) %}
          {% if feature_id not in feature_ids %}
            {% set all_features = all_features|merge([action]) %}
            {% set feature_ids = feature_ids|merge([feature_id]) %}
          {% endif %}
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endfor %}
{% endif %}

{# Check for feats #}
{% if character.feats is defined %}
  {% for feat in character.feats %}
    {% if _self.shouldIncludeFeature(feat) %}
      {% set feature_id = feat.id ?? feat.definition.id ?? ('feat_' ~ loop.index0) %}
      {% if feature_id not in feature_ids %}
        {% set all_features = all_features|merge([feat]) %}
        {% set feature_ids = feature_ids|merge([feature_id]) %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

{# Check for modifiers that have component types #}
{% if character.modifiers is defined %}
  {% for modifier_category in character.modifiers %}
    {% if modifier_category is iterable %}
      {% for modifier in modifier_category %}
        {% if modifier.componentTypeId is defined and _self.shouldIncludeFeature(modifier) %}
          {% set feature_id = modifier.id ?? modifier.componentId ?? ('mod_' ~ loop.parent.loop.index0 ~ '_' ~ loop.index0) %}
          {% if feature_id not in feature_ids %}
            {% set all_features = all_features|merge([modifier]) %}
            {% set feature_ids = feature_ids|merge([feature_id]) %}
          {% endif %}
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endfor %}
{% endif %}

{# Group features by activation type #}
{% set action_features = [] %}
{% set bonus_action_features = [] %}
{% set reaction_features = [] %}
{% set attack_features = [] %}
{% set special_features = [] %}

{% for feature in all_features %}
  {% set activation_type = (feature.definition.activation.activationType ?? feature.activation.activationType ?? '')|lower %}
  {% set description = (feature.definition.description ?? feature.snippet ?? feature.description ?? '')|lower %}

  {# Categorize based on activation type or description keywords #}
  {% if 'reaction' in activation_type or 'reaction' in description %}
    {% set reaction_features = reaction_features|merge([feature]) %}
  {% elseif 'bonus' in activation_type or 'bonus action' in description %}
    {% set bonus_action_features = bonus_action_features|merge([feature]) %}
  {% elseif 'action' in activation_type and 'bonus' not in activation_type %}
    {% set action_features = action_features|merge([feature]) %}
  {% elseif 'attack' in description or 'when you hit' in description or 'per attack' in description %}
    {% set attack_features = attack_features|merge([feature]) %}
  {% else %}
    {% set special_features = special_features|merge([feature]) %}
  {% endif %}
{% endfor %}

{# Sort each group alphabetically #}
{% set action_features = action_features|sort((a, b) => (a.definition.name ?? a.name ?? '') <=> (b.definition.name ?? b.name ?? '')) %}
{% set bonus_action_features = bonus_action_features|sort((a, b) => (a.definition.name ?? a.name ?? '') <=> (b.definition.name ?? b.name ?? '')) %}
{% set reaction_features = reaction_features|sort((a, b) => (a.definition.name ?? a.name ?? '') <=> (b.definition.name ?? b.name ?? '')) %}
{% set attack_features = attack_features|sort((a, b) => (a.definition.name ?? a.name ?? '') <=> (b.definition.name ?? b.name ?? '')) %}
{% set special_features = special_features|sort((a, b) => (a.definition.name ?? a.name ?? '') <=> (b.definition.name ?? b.name ?? '')) %}

{% set has_any_features = action_features is not empty or bonus_action_features is not empty or reaction_features is not empty or attack_features is not empty or special_features is not empty %}

{% if has_any_features %}
  <div class="row">
    <div class="col mb-1">
      <button
        class="btn btn-success" type="button" data-toggle="collapse"
        data-target="#features-{{ character.id }}" aria-expanded="false"
        aria-controls="features-{{ character.id }}"
      >Features & Actions
      </button>
    </div>
    <div class="w-100"></div>
    <div class="col">
      <div class="features row collapse" id="features-{{ character.id }}">
        {# Display features grouped by activation type #}

        {# Reactions #}
        {% if reaction_features is not empty %}
          <div class="col-12 mt-2">
            <h6 class="text-muted">Reactions</h6>
          </div>
          {% for feature in reaction_features %}
            {% include 'sheet/character-card/components/character-card--feature-item.html.twig' with {'feature': feature} only %}
          {% endfor %}
        {% endif %}

        {# Bonus Actions #}
        {% if bonus_action_features is not empty %}
          <div class="col-12 mt-2">
            <h6 class="text-muted">Bonus Actions</h6>
          </div>
          {% for feature in bonus_action_features %}
            {% include 'sheet/character-card/components/character-card--feature-item.html.twig' with {'feature': feature} only %}
          {% endfor %}
        {% endif %}

        {# Actions #}
        {% if action_features is not empty %}
          <div class="col-12 mt-2">
            <h6 class="text-muted">Actions</h6>
          </div>
          {% for feature in action_features %}
            {% include 'sheet/character-card/components/character-card--feature-item.html.twig' with {'feature': feature} only %}
          {% endfor %}
        {% endif %}

        {# On Attack #}
        {% if attack_features is not empty %}
          <div class="col-12 mt-2">
            <h6 class="text-muted">On Attack</h6>
          </div>
          {% for feature in attack_features %}
            {% include 'sheet/character-card/components/character-card--feature-item.html.twig' with {'feature': feature} only %}
          {% endfor %}
        {% endif %}

        {# Special/Other #}
        {% if special_features is not empty %}
          <div class="col-12 mt-2">
            <h6 class="text-muted">Other</h6>
          </div>
          {% for feature in special_features %}
            {% include 'sheet/character-card/components/character-card--feature-item.html.twig' with {'feature': feature} only %}
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}
