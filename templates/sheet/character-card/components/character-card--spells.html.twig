{# Show all spells for DM screen - this is a DM tool so show everything #}
{# Check for both legacy (classSpells) and 2024 (spells.class) spell data #}
{% set has_any_spells = false %}
{% if character.classSpells is defined %}
  {% for class in character.classSpells %}
    {% if class.spells is defined and class.spells is not empty %}
      {% set has_any_spells = true %}
    {% endif %}
  {% endfor %}
{% endif %}
{# Also check for 2024 spells in character.spells (class, race, item, feat) #}
{% if character.spells is defined %}
  {% if (character.spells.class is defined and character.spells.class is not empty)
     or (character.spells.race is defined and character.spells.race is not empty)
     or (character.spells.item is defined and character.spells.item is not empty)
     or (character.spells.feat is defined and character.spells.feat is not empty) %}
    {% set has_any_spells = true %}
  {% endif %}
{% endif %}

{% if has_any_spells %}
  <div class="row">
    <div class="col mb-1">
      <button
        class="btn btn-primary" type="button" data-toggle="collapse"
        data-target="#spells-{{ character.id }}" aria-expanded="false"
        aria-controls="spells-{{ character.id }}"
      >Spells
      </button>
    </div>
    <div class="w-100"></div>
    <div class="col">
      <div class="spells row collapse" id="spells-{{ character.id }}">
        {# Display legacy (2014) spells from classSpells #}
        {% if character.classSpells is defined %}
          {% for class in character.classSpells %}
            {% if class.spells is defined and class.spells is not empty %}
              {% for spell in class.spells %}
                <div class="col-12">
                  <span class="badge badge-info">{{ spell.definition.level }}</span>
                  <a
                    href="#"
                    data-toggle="popover"
                    data-trigger="focus"
                    data-html="true"
                    title="{{ spell.definition.name|e }}"
                    data-content="{{ spell.definition.description|e('html_attr') }}"
                  >{{ spell.definition.name }}</a>
                </div>
              {% endfor %}
            {% endif %}
          {% endfor %}
        {% endif %}

        {# Display 2024 spells from all sources: class, race, item, feat #}
        {% if character.spells is defined %}
          {# Class spells #}
          {% if character.spells.class is defined %}
            {% for spell in character.spells.class %}
              <div class="col-12">
                <span class="badge badge-info">{{ spell.definition.level }}</span>
                <a
                  href="#"
                  data-toggle="popover"
                  data-trigger="focus"
                  data-html="true"
                  title="{{ spell.definition.name|e }}"
                  data-content="{{ spell.definition.description|e('html_attr') }}"
                >{{ spell.definition.name }}</a>
              </div>
            {% endfor %}
          {% endif %}

          {# Race spells #}
          {% if character.spells.race is defined %}
            {% for spell in character.spells.race %}
              <div class="col-12">
                <span class="badge badge-info">{{ spell.definition.level }}</span>
                <a
                  href="#"
                  data-toggle="popover"
                  data-trigger="focus"
                  data-html="true"
                  title="{{ spell.definition.name|e }}"
                  data-content="{{ spell.definition.description|e('html_attr') }}"
                >{{ spell.definition.name }}</a>
              </div>
            {% endfor %}
          {% endif %}

          {# Item spells #}
          {% if character.spells.item is defined %}
            {% for spell in character.spells.item %}
              <div class="col-12">
                <span class="badge badge-info">{{ spell.definition.level }}</span>
                <a
                  href="#"
                  data-toggle="popover"
                  data-trigger="focus"
                  data-html="true"
                  title="{{ spell.definition.name|e }}"
                  data-content="{{ spell.definition.description|e('html_attr') }}"
                >{{ spell.definition.name }}</a>
              </div>
            {% endfor %}
          {% endif %}

          {# Feat spells #}
          {% if character.spells.feat is defined %}
            {% for spell in character.spells.feat %}
              <div class="col-12">
                <span class="badge badge-info">{{ spell.definition.level }}</span>
                <a
                  href="#"
                  data-toggle="popover"
                  data-trigger="focus"
                  data-html="true"
                  title="{{ spell.definition.name|e }}"
                  data-content="{{ spell.definition.description|e('html_attr') }}"
                >{{ spell.definition.name }}</a>
              </div>
            {% endfor %}
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}
